ANTHROPIC_API_KEY=
FIRECRAWL_API_KEY=
RECUR_MODEL_WRITER=claude-opus-5-5
RECUR_MODEL_JUDGE=claude-sonnet-5-5
RECUR_MODEL_FAST=claude-haiku-5-5
RECUR_MODEL_VISION=claude-sonnet-5-5
RECUR_MAX_QA_ROUNDS=3
FIRECRAWL_RPM=10             # requests/minute; raise to your plan's limit (free plan = 10)
RECUR_FETCH_MODE=direct-first   # direct-first (saves Firecrawl credits) | firecrawl
RECUR_SERVER_FALLBACK=true   # Anthropic server-side refusal fallback for Opus/Sonnet 5.5
RECUR_MAX_COST_USD=2.00      # hard ceiling per deck: Claude dollars + Firecrawl credits x FIRECRAWL_USD_PER_CREDIT
FIRECRAWL_USD_PER_CREDIT=0.0 # e.g. 0.0053 on the Hobby plan ($16 / 3,000 credits); 0 = credits don't count
# RECUR_TARGET_COVER_MIN_DPI=200  # the target's own cover logo is replaced by typeset type only below this dpi
